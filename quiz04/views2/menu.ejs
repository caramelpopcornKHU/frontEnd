<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>메뉴 페이지</title>
    </head>
    <body>

        
        <h1> 관리 선택 페이지 </h1>
        <p><%= username %>님 환영합니다</p>

        <div>
            
        </div>
        <div>
            
            <button onclick="clientManage()">고객 관리</button> <p></p>
            <button onclick="productManage()">상품 관리</button> <p></p>
            <button onclick="salesManage()">매출 관리</button> <p></p>
            <p>선택했던 화면 : <%= prevPage %></p>
            <button onclick="logout()">로그아웃</button>

        </div>

        <script>
            function logout(){
                console.log(`logout함수 실행됨`);

                const form = document.createElement('form');
                form.setAttribute('action','/page/loginPage');

                document.body.appendChild(form);

                form.submit();
            }

            function clientManage(){
                console.log(`clientManage함수 실행됨`);
                // req.query는 서버 코드에서만 사용됩니다! 프론트에서는 URL 파라미터를 수동으로 얻어야 해요.
                const urlParams = new URLSearchParams(window.location.search);
                const username = urlParams.get('username');
                const form = document.createElement('form');
                form.setAttribute('action', '/page/clientManage');
                form.setAttribute('method', 'get');
                const data1 = document.createElement('input'); // ← 여기가 핵심!
                data1.setAttribute('type', 'hidden');
                data1.setAttribute('name', 'username');
                data1.setAttribute('value', username);
                form.appendChild(data1);
                document.body.appendChild(form);
                form.submit();
            }
            function productManage(){
                console.log(`productManage함수 실행됨`);
                // req.query는 서버 코드에서만 사용됩니다! 프론트에서는 URL 파라미터를 수동으로 얻어야 해요.
                const urlParams = new URLSearchParams(window.location.search);
                const username = urlParams.get('username');
                const form = document.createElement('form');
                form.setAttribute('action', '/page/productManage');
                form.setAttribute('method', 'get');
                const data1 = document.createElement('input'); // ← 여기가 핵심!
                data1.setAttribute('type', 'hidden');
                data1.setAttribute('name', 'username');
                data1.setAttribute('value', username);
                form.appendChild(data1);
                document.body.appendChild(form);
                form.submit();
            }
            function salesManage(){
                console.log(`salesManage함수 실행됨`);
                // req.query는 서버 코드에서만 사용됩니다! 프론트에서는 URL 파라미터를 수동으로 얻어야 해요.
                const urlParams = new URLSearchParams(window.location.search);
                const username = urlParams.get('username');
                const form = document.createElement('form');
                form.setAttribute('action', '/page/salesManage');
                form.setAttribute('method', 'get');
                const data1 = document.createElement('input'); // ← 여기가 핵심!
                data1.setAttribute('type', 'hidden');
                data1.setAttribute('name', 'username');
                data1.setAttribute('value', username);
                form.appendChild(data1);
                document.body.appendChild(form);
                form.submit();
            }
        </script>
        

    </body>
    
</html>