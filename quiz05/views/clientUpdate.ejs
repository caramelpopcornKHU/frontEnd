<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>고객 추가</title>
    </head>

    <body>
        <h1>고객 정보 수정</h1>
        <div> <!-- 이름 나이 전화번호 입력 -->
            <form action="/person/modify" method="get">
                <input type="hidden" name="id" value="<%= params.id%>">
                <span>이름     </span> <input type="text" name="name" value="<%=params.name%>"> <p></p>
                <span>나이     </span> <input type="text" name="age" value="<%=params.age%>"> <p></p>
                <span>전화번호 </span> <input type="text" name="mobile" value="<%=params.mobile%>"> <p></p>
                <button>저장</button>
            </form>
            <form action="/person/list" method="get" >
                <button>취소</button>
            </form>
            
        </div>

        <div> <!-- 저장, 취소 버튼 -->
            
            

        </div>
    </body>
</html>