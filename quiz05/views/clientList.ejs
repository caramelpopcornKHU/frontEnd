<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>고객 목록</title>
    </head>
    <body>
        <h1>고객 목록</h1>
        
        <div> <!-- 총 몇명--> 
            <span>총 <%=persons.length%>명</span>
        </div>
        <div>
            <table>
                <tr> <!-- table row 테이블의 한 행  -->
                    <th>이름</th>
                    <th>나이</th>
                    <th>전화번호</th>
                    <th>수정 삭제</th>
                </tr>

                <% for(let i=0;i<persons.length;i++) { %>
                    <tr>
                        <td><%= persons[i].name %></td>
                        <td><%= persons[i].age %></td>
                        <td><%= persons[i].mobile %></td>
                        <td>
                            <button id="revise" onclick="reviseData(this)" 
                            data-id="<%= persons[i].id %>"
                            data-name="<%= persons[i].name %>"
                            data-age="<%= persons[i].age %>"
                            data-mobile="<%= persons[i].mobile %>"
                            >
                                수정</button>
                        </td>
                        <td><button id="delete" onclick="deleteData(this)"
                            data-id="<%= persons[i].id %>"
                            data-name="<%= persons[i].name %>"
                            data-age="<%= persons[i].age %>"
                            data-mobile="<%= persons[i].mobile %>"
                            >삭제</button>
                        </td>
                    </tr>


                <% }%>
            </table>
        </div>
        <div>
            <button onclick="addClient()">추가</button>
        </div>
        <script>
            function reviseData(button){
                console.log(`수정 버튼 클릭`);
                
                const id = button.dataset.id;
                const name = button.dataset.name;
                const age = button.dataset.age;
                const mobile = button.dataset.mobile;

                // 서버에 보낼 form 만들기
                const form = document.createElement('form');
                form.setAttribute('action','/person/update'); // http://localhost:7001/person/update로 고고링
                form.setAttribute('method','get');

                // http://localhost:7001/person/update?id=1
                const inputId = document.createElement('input');
                inputId.setAttribute('type', 'hidden');
                inputId.setAttribute('name', 'id'); // ?id=
                inputId.setAttribute('value', id); // ?id=1
                form.appendChild(inputId);
                
                
                // http://localhost:7001/person/update?id=1&name=홍길동
                const inputName = document.createElement('input');
                inputName.setAttribute('type', 'hidden');
                inputName.setAttribute('name', 'name'); // ?name=
                inputName.setAttribute('value', name); // ?name=이름
                form.appendChild(inputName);

                // http://localhost:7001/person/update?id=1&name=홍길동&age=30
                const inputAge = document.createElement('input');
                inputAge.setAttribute('type', 'hidden');
                inputAge.setAttribute('name', 'age'); // ?age=
                inputAge.setAttribute('value', age); // ?age=30
                form.appendChild(inputAge);

                // http://localhost:7001/person/update?id=1&name=홍길동&age=30&mobile=010-1111-1111
                const inputMobile = document.createElement('input');
                inputMobile.setAttribute('type', 'hidden');
                inputMobile.setAttribute('name', 'mobile'); // ?mobile=
                inputMobile.setAttribute('value', mobile); // ?mobile=010-1111-1111
                form.appendChild(inputMobile);

                document.body.appendChild(form);

                form.submit();
            }

            function deleteData(button){
                console.log(`삭제 버튼 클릭`);

                const id = button.dataset.id;
                const name = button.dataset.name;
                const age = button.dataset.age;
                const mobile = button.dataset.mobile;

                // 서버에 보낼 form 만들기
                const form = document.createElement('form');
                form.setAttribute('action','/person/delete'); // http://localhost:7001/person/delete로 고고링
                form.setAttribute('method','get');

                // http://localhost:7001/person/delete?id=1
                const inputId = document.createElement('input');
                inputId.setAttribute('type', 'hidden');
                inputId.setAttribute('name', 'id'); // ?id=
                inputId.setAttribute('value', id); // ?id=1
                form.appendChild(inputId);
                
                
                // http://localhost:7001/person/delete?id=1&name=홍길동
                const inputName = document.createElement('input');
                inputName.setAttribute('type', 'hidden');
                inputName.setAttribute('name', 'name'); // ?name=
                inputName.setAttribute('value', name); // ?name=이름
                form.appendChild(inputName);

                // http://localhost:7001/person/delete?id=1&name=홍길동&age=30
                const inputAge = document.createElement('input');
                inputAge.setAttribute('type', 'hidden');
                inputAge.setAttribute('name', 'age'); // ?age=
                inputAge.setAttribute('value', age); // ?age=30
                form.appendChild(inputAge);

                // http://localhost:7001/person/delete?id=1&name=홍길동&age=30&mobile=010-1111-1111
                const inputMobile = document.createElement('input');
                inputMobile.setAttribute('type', 'hidden');
                inputMobile.setAttribute('name', 'mobile'); // ?mobile=
                inputMobile.setAttribute('value', mobile); // ?mobile=010-1111-1111
                form.appendChild(inputMobile);

                document.body.appendChild(form);

                form.submit();
            }
        
            function addClient(){
                console.log(`추가 버튼 누름 - addClient() 실행`);

                // 서버에 보낼 form 만들기
                const form = document.createElement('form');
                form.setAttribute('action','/person/addClient'); // http://localhost:7001/person/addClient로 고고링
                form.setAttribute('method','get');
                document.body.appendChild(form);

                form.submit();
            }
        </script>
    </body>
</html>